{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ops-core-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "observability": { "enabled": true },
  "secrets": {
    "required": [
      "OPS_CORE_API_KEY",
      "GOOGLE_SERVICE_ACCOUNT_EMAIL",
      "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY",
      "OPS_STAGING_URL",
      "OPS_STAGING_FETCH_KEY",
      "RESEND_API_KEY",
      "RESEND_FROM_EMAIL"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ops_core_db_dev",
      "database_id": "5058bdad-d45c-4071-8d25-ee5f2355bf40",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "ops-artifacts-dev" }
  ],
  "queues": {
    "producers": [
      { "binding": "EXECUTION_QUEUE", "queue": "ops-execution-ingress-dev" }
    ],
    "consumers": [
      {
        "queue": "ops-execution-ingress-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "ops-execution-ingress-dlq-dev",
        "retry_delay": 5
      }
    ]
  },
  "workflows": [
    { "name": "ops-core-execution-dev", "binding": "CORE_EXECUTION_WORKFLOW", "class_name": "CoreExecutionWorkflow" }
  ]
}
